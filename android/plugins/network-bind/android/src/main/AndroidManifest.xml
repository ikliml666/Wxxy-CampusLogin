<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- requestNetwork 回退路径必需（普通权限，声明即生效）。
         缺失时 ConnectivityManager.requestNetwork 直接抛 SecurityException：
         "was not granted either of these permissions: CHANGE_NETWORK_STATE, WRITE_SETTINGS"
         （2026-09-12 真机日志实证）——绑定因此在直绑失败后连回退也走不通。 -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- WiFi SSID 获取（API 33+）：neverForLocation 标记使 getSSID 免定位权限、
         免系统定位服务开关；运行时经 requestWifiSsidPermission 弹框请求。
         API < 33 取 SSID 需 ACCESS_FINE_LOCATION + 定位开关，本应用不引入，恒「未获取」。 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
</manifest>
