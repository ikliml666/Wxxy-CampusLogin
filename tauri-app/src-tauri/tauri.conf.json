{
  "productName": "校园网登录助手",
  "version": "2.4.2",
  "identifier": "com.campus.login",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd frontend && npm run build",
    "beforeBundleCommand": "cd src-tauri && cargo build --release --bin campus-login-core && pwsh -NoProfile -Command \"$t=(cargo metadata --format-version 1 | ConvertFrom-Json).target_directory; New-Item -ItemType Directory -Force binaries | Out-Null; Copy-Item ($t + [char]47 + 'release/campus-login-core.exe') 'binaries/campus-login-core-x86_64-pc-windows-msvc.exe' -Force\"",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "校园网登录助手",
        "width": 1360,
        "height": 768,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "visible": false,
        "url": "/",
        "useHttpsScheme": false,
        "browserExtensionsEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc://localhost; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],

    "resources": [
      "resources/mascot-update-toast.png",
      "resources/mascot-toast/*",
      "icons/128x128.png"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
